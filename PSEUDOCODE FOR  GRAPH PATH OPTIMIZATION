{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"15yqyFhZwx-XMtIAx1KO4RMrH5wnfbYtx","timestamp":1790755941990},{"file_id":"1-3hkUm7JSui7dG_nioKwSDUqb23pVY7r","timestamp":1790755669928}],"authorship_tag":"ABX9TyMVIQhgdlLdTFj+hZJ1mTfh"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["import random\n","\n","# 1. Define the Graph using an Adjacency Matrix\n","# format: graph[u][v] = weight (0 means no direct edge)\n","GRAPH = [\n","    [0, 4, 2, 0, 0, 0],  # Node 0\n","    [4, 0, 1, 5, 0, 0],  # Node 1\n","    [2, 1, 0, 8, 10, 0], # Node 2\n","    [0, 5, 8, 0, 2, 6],  # Node 3\n","    [0, 0, 10, 2, 0, 3], # Node 4\n","    [0, 0, 0, 6, 3, 0]   # Node 5\n","]\n","\n","START_NODE = 0\n","END_NODE = 5\n","\n","# GA Hyperparameters\n","POP_SIZE = 20\n","GENERATIONS = 50\n","CROSSOVER_RATE = 0.8\n","MUTATION_RATE = 0.2\n","\n","def generate_random_path(graph, start, end):\n","    \"\"\"Generates a valid path from start to end by randomly walking the graph nodes.\"\"\"\n","    path = [start]\n","    current = start\n","    visited = {start}\n","\n","    while current != end:\n","        # Find neighbors that have a valid connected edge (> 0)\n","        neighbors = [i for i, weight in enumerate(graph[current]) if weight > 0 and i not in visited]\n","        if not neighbors:\n","            # Dead end: retry generating a completely new path\n","            return generate_random_path(graph, start, end)\n","\n","        current = random.choice(neighbors)\n","        path.append(current)\n","        visited.add(current)\n","    return path\n","\n","def calculate_fitness(path, graph):\n","    \"\"\"Calculates path cost. Lower cost = Higher fitness. Returns (1 / total_cost).\"\"\"\n","    total_cost = 0\n","    for i in range(len(path) - 1):\n","        u, v = path[i], path[i+1]\n","        weight = graph[u][v]\n","        if weight == 0:  # Invalid path segment safety check\n","            return 0\n","        total_cost += weight\n","    return 1 / total_cost if total_cost > 0 else 0\n","\n","def get_path_cost(path, graph):\n","    \"\"\"Utility to extract the exact structural weight of a path.\"\"\"\n","    return sum(graph[path[i]][path[i+1]] for i in range(len(path) - 1))\n","\n","def selection(population, fitness_scores):\n","    \"\"\"Tournament Selection: Chooses the best path out of a random subset.\"\"\"\n","    tournament_size = 3\n","    selected = random.sample(list(zip(population, fitness_scores)), tournament_size)\n","    # Sort by fitness score descending and return the path\n","    selected.sort(key=lambda x: x[1], reverse=True)\n","    return selected[0][0]\n","\n","def crossover(parent1, parent2):\n","    \"\"\"One-point crossover based on a common intersecting node.\"\"\"\n","    # Find intersecting nodes between the two paths (excluding start and end if possible)\n","    common_nodes = list(set(parent1[1:-1]) & set(parent2[1:-1]))\n","\n","    if not common_nodes or random.random() > CROSSOVER_RATE:\n","        return parent1.copy(), parent2.copy() # Return clones if no common intersection\n","\n","    pivot = random.choice(common_nodes)\n","    idx1 = parent1.index(pivot)\n","    idx2 = parent2.index(pivot)\n","\n","    # Splice paths together at the intersection point\n","    child1 = parent1[:idx1] + parent2[idx2:]\n","    child2 = parent2[:idx2] + parent1[idx1:]\n","\n","    # Remove loops if any occurred during splicing\n","    child1 = remove_loops(child1)\n","    child2 = remove_loops(child2)\n","\n","    return child1, child2\n","\n","def remove_loops(path):\n","    \"\"\"Cleans up paths that contain cyclic redundancy.\"\"\"\n","    clean_path = []\n","    for node in path:\n","        if node in clean_path:\n","            # Cut the path back to where the node first appeared\n","            clean_path = clean_path[:clean_path.index(node) + 1]\n","        else:\n","            clean_path.append(node)\n","    return clean_path\n","\n","def mutate(path, graph):\n","    \"\"\"Mutates a path by picking a random internal node and rebuilding to the end.\"\"\"\n","    if random.random() > MUTATION_RATE or len(path) <= 2:\n","        return path\n","\n","    # Pick a random node along the path (excluding the destination)\n","    mutation_point = random.randint(0, len(path) - 2)\n","    mutated_node = path[mutation_point]\n","\n","    # Re-generate a valid sub-path from this point forward to the destination\n","    try:\n","        sub_path = generate_random_path(graph, mutated_node, path[-1])\n","        return path[:mutation_point] + sub_path\n","    except RecursionError:\n","        return path # Fallback to original if regeneration gets trapped\n","\n","# 2. Main Genetic Algorithm Execution Loop\n","def genetic_algorithm():\n","    # Initialize Population\n","    population = [generate_random_path(GRAPH, START_NODE, END_NODE) for _ in range(POP_SIZE)]\n","\n","    best_path = None\n","    best_cost = float('inf')\n","\n","    print(f\"Optimizing path from Node {START_NODE} to Node {END_NODE}...\\n\")\n","\n","    for generation in range(GENERATIONS):\n","        # Calculate fitness for all individuals\n","        fitness_scores = [calculate_fitness(ind, GRAPH) for ind in population]\n","\n","        # Track the absolute best individual in the current generation\n","        for ind in population:\n","            cost = get_path_cost(ind, GRAPH)\n","            if cost < best_cost:\n","                best_cost = cost\n","                best_path = ind\n","\n","        # Generate the next generation population\n","        new_population = []\n","        while len(new_population) < POP_SIZE:\n","            # Selection\n","            p1 = selection(population, fitness_scores)\n","            p2 = selection(population, fitness_scores)\n","\n","            # Crossover\n","            c1, c2 = crossover(p1, p2)\n","\n","            # Mutation\n","            c1 = mutate(c1, GRAPH)\n","            c2 = mutate(c2, GRAPH)\n","\n","            new_population.extend([c1, c2])\n","\n","        population = new_population[:POP_SIZE] # Keep population size fixed\n","\n","        if (generation + 1) % 10 == 0 or generation == 0:\n","            print(f\"Generation {generation + 1}: Best Route Cost = {best_cost} | Path = {best_path}\")\n","\n","    print(\"\\n=== Optimization Complete ===\")\n","    print(f\"Optimal Path Found: {best_path}\")\n","    print(f\"Minimum Distance/Cost: {best_cost}\")\n","\n","if __name__ == \"__main__\":\n","    genetic_algorithm()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"SdugLnzeO0VL","executionInfo":{"status":"ok","timestamp":1790753602288,"user_tz":-330,"elapsed":28,"user":{"displayName":"Baduboina Sai Sathvik Yadav","userId":"07693403752199262660"}},"outputId":"8824ff82-011f-4648-bdc3-a58d8cd8cc64"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Optimizing path from Node 0 to Node 5...\n","\n","Generation 1: Best Route Cost = 13 | Path = [0, 2, 1, 3, 4, 5]\n","Generation 10: Best Route Cost = 13 | Path = [0, 2, 1, 3, 4, 5]\n","Generation 20: Best Route Cost = 13 | Path = [0, 2, 1, 3, 4, 5]\n","Generation 30: Best Route Cost = 13 | Path = [0, 2, 1, 3, 4, 5]\n","Generation 40: Best Route Cost = 13 | Path = [0, 2, 1, 3, 4, 5]\n","Generation 50: Best Route Cost = 13 | Path = [0, 2, 1, 3, 4, 5]\n","\n","=== Optimization Complete ===\n","Optimal Path Found: [0, 2, 1, 3, 4, 5]\n","Minimum Distance/Cost: 13\n"]}]}]}